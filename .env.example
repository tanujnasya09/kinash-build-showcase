# ─── Sanity CMS (optional) ───────────────────────────────────────────────
# Leave VITE_SANITY_PROJECT_ID empty to run in demo mode (listings from
# src/data/properties.ts, editable at /admin in the browser).
# Fill it in to load listings live from Sanity. Full guide: SANITY-SETUP.md
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-10-01
# Your deployed Studio, e.g. https://apex-luxury.sanity.studio
VITE_SANITY_STUDIO_URL=
