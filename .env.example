# ─── Sanity CMS (optional) ───────────────────────────────────────────────
# Leave NEXT_PUBLIC_SANITY_PROJECT_ID empty to run in demo mode (listings from
# src/data/properties.ts, editable at /admin in the browser).
# Fill it in to load listings live from Sanity. Full guide: SANITY-SETUP.md
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Your deployed Studio, e.g. https://apex-luxury.sanity.studio
NEXT_PUBLIC_SANITY_STUDIO_URL=

# Backwards compatibility with Vite-style env vars:
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=
VITE_SANITY_API_VERSION=
VITE_SANITY_STUDIO_URL=
